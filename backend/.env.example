# backend/.env  — copy this file to backend/.env and fill in as needed.
#
# This file lives in the BACKEND only. The Anthropic key never reaches the browser; it stays
# on the researcher's laptop for the local, supervised study.
#
# Out of the box the app runs fully in STUB mode (canned responses, no key needed) — you can
# click through the entire wizard. Page 0 of the wizard also lets you pick stub vs live per
# session; the settings below are just the default the selector starts on.

# Default model-call mode. "true" = stubbed (no key needed). Set to "false" to default to live.
USE_STUB=true

# Required only for LIVE calls (USE_STUB=false, or picking "Live API" on page 0) AND once the
# real call is implemented (see the `# TODO: replace stub with real Anthropic call` in
# backend/calls/_stub.py).
ANTHROPIC_API_KEY=
