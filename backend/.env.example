# Copy to backend/.env and fill in. NEVER commit the real key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown):
# STUDY_MODEL=claude-sonnet-4-6
# STUDY_MAX_TOKENS=4096
# STUDENT_CLUB_DB=./data/student_club.sqlite
# STUDY_LOG_DIR=./logs
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Deployed / online version (see DEPLOY.md) ---
# Where participant data is stored. Unset (local dev) -> a SQLite file under
# STUDY_LOG_DIR, so the app runs with zero setup. Set -> a Postgres database
# (Render fills this in for you on deploy). Accepts postgres:// or
# postgresql:// URLs. Point it at your Render DB's external URL to pull data
# locally with scripts/export_csv.py.
# DATABASE_URL=postgresql://user:password@host:5432/study_logs
# When set, enables downloading collected data from a browser at
#   /api/admin/export?token=THIS_VALUE
# Leave unset to keep the endpoint disabled (returns 404). Use a long random
# string and keep it secret — anyone with it can read all participant data.
# ADMIN_TOKEN=
# Path to the built frontend the backend should serve (the combined deployment
# sets this automatically; unset in local dev so only the API runs).
# FRONTEND_DIST=../frontend/dist
