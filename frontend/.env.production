# Used automatically by `vite build` (production mode).
#
# Empty = the built app calls /api on its OWN origin. That is what the
# recommended single-service deployment needs (FastAPI serves this app and the
# API together), and it means there is nothing to configure.
#
# For a split deployment (frontend and backend on different hosts), set this to
# the backend's full URL instead, e.g.:
#   VITE_API_BASE=https://your-backend.onrender.com
VITE_API_BASE=
